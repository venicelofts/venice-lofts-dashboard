# Venice Lofts — copy to .env.local and fill in values. Never commit .env.local.
# Setup guides: docs/README.md


# -----------------------------------------------------------------------------
# Supabase [required]
# Dashboard → Project Settings → API
# -----------------------------------------------------------------------------

# Public — safe to expose in the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional alias if your Supabase dashboard still labels the key "anon"
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Server-only — never use a NEXT_PUBLIC_* prefix
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# -----------------------------------------------------------------------------
# Local scanner [required for `pnpm scan` today]
# See docs/first-scan.md — not needed for dashboard-only / employee UI
# Copy SCAN_USER_ID from Settings after first sign-in
# -----------------------------------------------------------------------------

SCAN_USER_ID=

# Email (Microsoft Graph) — optional if using SCAN_FOLDERS instead
# Requires Application Mail.Read + admin consent on the Entra app
GRAPH_MAILBOX=
SCAN_LOOKBACK_HOURS=48

# Local PDF folders — comma-separated absolute paths; optional if using Graph mail
SCAN_FOLDERS=


# -----------------------------------------------------------------------------
# Anthropic [server]
# Thread summaries and nested task extraction
# https://console.anthropic.com
# -----------------------------------------------------------------------------

ANTHROPIC_API_KEY=


# -----------------------------------------------------------------------------
# Microsoft Graph [local scan + future server sync]
# Application permissions: Mail.Read, Calendars.Read (+ admin consent)
# Used by `pnpm scan` for mailbox read — not employee dashboard OAuth
# Azure Portal → Entra ID → App registrations
# -----------------------------------------------------------------------------

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=


# -----------------------------------------------------------------------------
# Scheduled sync [server]
# Random secret to authorize cron calls to the sync endpoint
# (e.g. Vercel Cron). Generate with: openssl rand -hex 32
# -----------------------------------------------------------------------------

SYNC_CRON_SECRET=


# -----------------------------------------------------------------------------
# Database migrations [optional]
# Only needed for `pnpm db:migrate` from your machine.
# Supabase → Project Settings → Database → Connection string (URI)
# Otherwise apply SQL in the Supabase SQL Editor.
# -----------------------------------------------------------------------------

# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
