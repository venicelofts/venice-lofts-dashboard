# Venice Lofts — copy to .env.local and fill in values. Never commit .env.local.
# Setup guides: docs/README.md


# -----------------------------------------------------------------------------
# Supabase [required]
# Dashboard → Project Settings → API
# -----------------------------------------------------------------------------

# Public — safe to expose in the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional alias if your Supabase dashboard still labels the key "anon"
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Server-only — never use a NEXT_PUBLIC_* prefix
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# -----------------------------------------------------------------------------
# Local scanner [required for `pnpm scan` today]
# See docs/first-scan.md — not needed for dashboard-only / employee UI
# Copy SCAN_USER_ID from Settings after first sign-in (any admin account).
# Scans write under this id; all signed-in users see the same shared ops data.
# -----------------------------------------------------------------------------

SCAN_USER_ID=

# Email + calendar (Microsoft Graph) — optional if using SCAN_FOLDERS instead
# Requires Application Mail.Read + Calendars.Read + admin consent on the Entra app
GRAPH_MAILBOX=
SCAN_LOOKBACK_HOURS=48
# How far ahead calendarView syncs (days from now)
SCAN_CALENDAR_FORWARD_DAYS=90

# Local PDF folders — comma-separated absolute paths; optional if using Graph mail
SCAN_FOLDERS=


# -----------------------------------------------------------------------------
# Anthropic [server]
# Thread summaries and nested task extraction
# https://console.anthropic.com
# -----------------------------------------------------------------------------

ANTHROPIC_API_KEY=


# -----------------------------------------------------------------------------
# Microsoft Graph [local scan + /api/sync cron]
# Application permissions: Mail.Read, Calendars.Read (+ admin consent)
# Used by `pnpm scan` and secured `/api/sync` — not employee dashboard OAuth
# Azure Portal → Entra ID → App registrations
# -----------------------------------------------------------------------------

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=


# -----------------------------------------------------------------------------
# Dev login [local only]
# Shows "Continue as Developer" on /login when enabled.
# Requires Email provider enabled in Supabase Auth, plus a seed user
# (Dashboard → Authentication → Users, or admin.createUser).
# Never set ENABLE_DEV_LOGIN in production.
# -----------------------------------------------------------------------------

# NEXT_PUBLIC_ENABLE_DEV_LOGIN=true
# NEXT_PUBLIC_DEV_LOGIN_EMAIL=dev@thelofts.local
# NEXT_PUBLIC_DEV_LOGIN_PASSWORD=dev-access-local


# -----------------------------------------------------------------------------
# Scheduled sync [server]
# Random secret to authorize cron calls to POST /api/sync
# (e.g. Vercel Cron). Generate with: openssl rand -hex 32
# Send as: Authorization: Bearer <SYNC_CRON_SECRET>
# -----------------------------------------------------------------------------

SYNC_CRON_SECRET=


# -----------------------------------------------------------------------------
# Database migrations [optional]
# Only needed for `pnpm db:migrate` from your machine.
# Supabase → Project Settings → Database → Connection string (URI)
# Otherwise apply SQL in the Supabase SQL Editor.
# -----------------------------------------------------------------------------

# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
